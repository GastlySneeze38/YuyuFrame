                    </group>
                    <group android:name="eyes" android:pivotX="298" android:pivotY="276">
                        <path android:fillColor="#FFFFFF" android:pathData="M214,248 L264,245 L267,310 L217,313 Z M330,240 L379,237 L383,301 L333,304 Z" />
                        <group android:name="pupils">
                            <path android:fillColor="#0B0B10" android:pathData="M236,270 L259,268 L260,302 L238,303 Z M353,262 L375,261 L377,295 L355,296 Z" />
