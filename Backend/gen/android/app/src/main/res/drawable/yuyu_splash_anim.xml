                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.1" android:value="0.9" android:interpolator="@interpolator/ys_ease_in" />
                    <keyframe android:fraction="0.3" android:value="1.07" android:interpolator="@interpolator/ys_jump" />
