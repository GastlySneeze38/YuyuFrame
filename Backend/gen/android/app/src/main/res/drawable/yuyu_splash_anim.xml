    <!-- L'antenne gigote sans arrêt, trois fois par cycle (ys-wiggle). -->
    <target android:name="antenna">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="400" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
