        </vector>
    </aapt:attr>

    <!-- Le cadre : élan, tour avec dépassement, retour, respiration (ys-ring). -->
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1200" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="-14" android:interpolator="@interpolator/ys_wind" />
                    <keyframe android:fraction="0.45" android:value="372" android:interpolator="@interpolator/ys_spin" />
                    <keyframe android:fraction="0.55" android:value="360" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="0.7" android:value="360" android:interpolator="@interpolator/ys_ease_out" />
                    <keyframe android:fraction="0.85" android:value="360" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="1" android:value="360" android:interpolator="@interpolator/ys_ease" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.1" android:value="0.9" android:interpolator="@interpolator/ys_wind" />
                    <keyframe android:fraction="0.45" android:value="1.1" android:interpolator="@interpolator/ys_spin" />
                    <keyframe android:fraction="0.55" android:value="0.98" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="0.7" android:value="1.06" android:interpolator="@interpolator/ys_ease_out" />
                    <keyframe android:fraction="0.85" android:value="1" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="1" android:value="1" android:interpolator="@interpolator/ys_ease" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.1" android:value="0.9" android:interpolator="@interpolator/ys_wind" />
                    <keyframe android:fraction="0.45" android:value="1.1" android:interpolator="@interpolator/ys_spin" />
                    <keyframe android:fraction="0.55" android:value="0.98" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="0.7" android:value="1.06" android:interpolator="@interpolator/ys_ease_out" />
                    <keyframe android:fraction="0.85" android:value="1" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="1" android:value="1" android:interpolator="@interpolator/ys_ease" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

