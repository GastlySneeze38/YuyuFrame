    <!-- Le visage : écrasé, saut, réception, petit rebond (ys-hop). -->
    <target android:name="face">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1200" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="8" android:interpolator="@interpolator/ys_ease_in" />
                    <keyframe android:fraction="0.3" android:value="-56" android:interpolator="@interpolator/ys_jump" />
                    <keyframe android:fraction="0.48" android:value="4" android:interpolator="@interpolator/ys_fall" />
                    <keyframe android:fraction="0.6" android:value="-12" android:interpolator="@interpolator/ys_ease_out" />
                    <keyframe android:fraction="0.72" android:value="0" android:interpolator="@interpolator/ys_ease_in_out" />
                    <keyframe android:fraction="1" android:value="0" android:interpolator="@interpolator/ys_ease" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
