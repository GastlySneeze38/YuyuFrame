                    <keyframe android:fraction="0.1" android:value="-8" android:interpolator="@interpolator/ys_ease" />
                    <keyframe android:fraction="0.3" android:value="30" android:interpolator="@interpolator/ys_ease" />
                    <keyframe android:fraction="0.55" android:value="0" android:interpolator="@interpolator/ys_ease" />
                    <keyframe android:fraction="0.7" android:value="8" android:interpolator="@interpolator/ys_ease" />
                    <keyframe android:fraction="0.85" android:value="0" android:interpolator="@interpolator/ys_ease" />
                    <keyframe android:fraction="1" android:value="0" android:interpolator="@interpolator/ys_ease" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.1" android:value="0" android:interpolator="@interpolator/ys_ease" />
