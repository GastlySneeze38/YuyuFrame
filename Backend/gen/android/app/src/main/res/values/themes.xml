<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.yuyuframe_backend" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Le fond de l'interface (bg-primary) dès la première image, et Yuyu au
             centre : il tient la place jusqu'à ce que la page pose le sien
             (drawable/yuyu_window.xml). -->
        <item name="android:windowBackground">@drawable/yuyu_window</item>
        <item name="android:statusBarColor">@color/yuyu_background</item>
        <item name="android:navigationBarColor">@color/yuyu_background</item>
    </style>
</resources>
